# Python virtual env
.venv/
__pycache__/
*.pyc

# MATLAB autosave / backup
*.asv
*.m~
slprj/

# OS
Thumbs.db
.DS_Store

# Editor
.vscode/
*.swp

# Generated outputs (figures, logs)
outputs/**
*.log
*.exe
*.pdb

# STS-gold interactive visualizations — track in git despite outputs/ ignore
!outputs/sts_gold_*.html
!outputs/sts_gold_index.html

# Claude AI workspace (local only)
.claude/

# Temp visualization data
data_for_viz.json
stress_data.json

# One-time patch scripts
sim/_patch_atlas.py

# MATLAB Drive sync markers
.MATLABDriveTag

# VSCode Local History auto-backups
.history/

# ascent SIL build artifact
Firmware/sim_ascent/ascent_sim.exe

# SIL run artifacts — the shimmed SD.h writes these on every regression run.
# Scoped to the sim dirs on purpose: FLIGHT_LOG.csv at the repo root is the real flight record.
Firmware/sim_ascent/*.CSV
Firmware/sim/*.txt
